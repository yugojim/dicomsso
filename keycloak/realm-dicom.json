{
  "realm": "dicom",
  "enabled": true,
  "displayName": "DICOM Customer Portal",
  "loginTheme": "dicom",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "accessTokenLifespan": 1200,
  "ssoSessionIdleTimeout": 1200,
  "ssoSessionMaxLifespan": 1200,
  "roles": {
    "realm": [
      { "name": "viewer", "description": "Can view own uploaded DICOM studies" },
      { "name": "uploader", "description": "Can upload DICOM files" },
      { "name": "admin", "description": "Portal administrator" },
      { "name": "wazuh-admin", "description": "Can access Wazuh as an administrator" },
      { "name": "wazuh-readonly", "description": "Can access Wazuh as a read-only user" },
      { "name": "fhir-user", "description": "Can read FHIR resources on the HAPI FHIR server" },
      { "name": "fhir-admin", "description": "Can read and write FHIR resources on the HAPI FHIR server" }
    ]
  },
  "clients": [
    {
      "clientId": "dicom-portal",
      "name": "DICOM Portal Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost/*",
        "http://localhost:8088/*",
        "http://localhost:13000/*",
        "http://192.168.1.122/*",
        "http://192.168.1.122:8088/*",
        "http://192.168.1.122:13000/*",
        "http://192.168.1.112/*",
        "http://192.168.1.112:8088/*",
        "http://192.168.1.112:13000/*"
      ],
      "webOrigins": [
        "http://localhost",
        "http://localhost:8088",
        "http://localhost:13000",
        "http://192.168.1.122",
        "http://192.168.1.122:8088",
        "http://192.168.1.122:13000",
        "http://192.168.1.112",
        "http://192.168.1.112:8088",
        "http://192.168.1.112:13000"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer-a",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "A",
      "attributes": {
        "tenant_id": ["tenant-a"]
      },
      "credentials": [
        { "type": "password", "value": "customer-a", "temporary": false }
      ],
      "realmRoles": ["viewer", "uploader", "fhir-user"]
    },
    {
      "username": "customer-b",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "B",
      "attributes": {
        "tenant_id": ["tenant-b"]
      },
      "credentials": [
        { "type": "password", "value": "customer-b", "temporary": false }
      ],
      "realmRoles": ["viewer", "uploader", "fhir-user"]
    },
    {
      "username": "portal-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "portal-admin@example.local",
      "firstName": "Portal",
      "lastName": "Admin",
      "attributes": {
        "tenant_id": ["admin"]
      },
      "credentials": [
        { "type": "password", "value": "portal-admin", "temporary": false }
      ],
      "realmRoles": ["admin", "viewer", "uploader", "wazuh-admin", "fhir-user", "fhir-admin"]
    }
  ]
}
