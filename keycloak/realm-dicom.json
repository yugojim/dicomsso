{
  "realm": "dicom",
  "enabled": true,
  "displayName": "DICOM Customer Portal",
  "loginTheme": "dicom",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "accessTokenLifespan": 1200,
  "ssoSessionIdleTimeout": 1200,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Can view own uploaded DICOM studies"
      },
      {
        "name": "uploader",
        "description": "Can upload DICOM files"
      },
      {
        "name": "admin",
        "description": "Portal administrator"
      },
      {
        "name": "wazuh-admin",
        "description": "Can access Wazuh as an administrator"
      },
      {
        "name": "wazuh-readonly",
        "description": "Can access Wazuh as a read-only user"
      },
      {
        "name": "fhir-user",
        "description": "Can read FHIR resources on the HAPI FHIR server"
      },
      {
        "name": "fhir-admin",
        "description": "Can read and write FHIR resources on the HAPI FHIR server"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dicom-portal",
      "name": "DICOM Portal Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "https://192.168.1.122:8088/*",
        "https://192.168.1.122:13000/*",
        "https://192.168.1.112:8088/*",
        "https://192.168.1.112:13000/*",
        "https://192.168.1.105:8088/*",
        "https://192.168.1.105:13000/*",
        "https://localhost:8088/*",
        "https://localhost:13000/*",
        "https://127.0.0.1:8088/*",
        "https://127.0.0.1:13000/*"
      ],
      "webOrigins": [
        "https://192.168.1.122:8088",
        "https://192.168.1.122:13000",
        "https://192.168.1.112:8088",
        "https://192.168.1.112:13000",
        "https://192.168.1.105:8088",
        "https://192.168.1.105:13000",
        "https://localhost:8088",
        "https://localhost:13000",
        "https://127.0.0.1:8088",
        "https://127.0.0.1:13000"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer-a",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "A",
      "attributes": {
        "tenant_id": [
          "tenant-a"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "customer-a",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer",
        "uploader",
        "fhir-user"
      ],
      "email": "customer-a@example.local"
    },
    {
      "username": "customer-b",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "B",
      "attributes": {
        "tenant_id": [
          "tenant-b"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "customer-b",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer",
        "uploader",
        "fhir-user"
      ],
      "email": "customer-b@example.local"
    },
    {
      "username": "portal-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "portal-admin@example.local",
      "firstName": "Portal",
      "lastName": "Admin",
      "attributes": {
        "tenant_id": [
          "admin"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "portal-admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "viewer",
        "uploader",
        "wazuh-admin",
        "fhir-user",
        "fhir-admin"
      ]
    }
  ]
}